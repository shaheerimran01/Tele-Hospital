generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PharmacyRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  OUT_OF_STOCK
  EXPIRED
  PARTIALLY_AVAILABLE
}

model PharmacyOrderRequest {
  id                  String                @id @default(uuid())
  orderId             String
  pharmacyId          String
  status              PharmacyRequestStatus @default(PENDING)
  requestedAt         DateTime              @default(now())
  expiresAt           DateTime
  respondedAt         DateTime?
  responseTimeSeconds Int?

  availableOrderItemIds String[]            @default([])
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacy            Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  createdAt           DateTime              @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([orderId])
  @@index([pharmacyId])
  @@index([status])
  @@index([pharmacyId, status])
}

model User {
  id                     String  @id @default(uuid())
  phone                  String? @unique
  email                  String? @unique
  firstName              String?
  lastName               String?
  healthcareProfessional Boolean @default(false)

  addresses Address[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cart              Cart?
  orders            Order[]
  prescriptions     Prescription[]
  userNotifications UserNotification[]
  familyMembers       FamilyMember[]
  consultationIntakes ConsultationIntake[]
  doctor                 Doctor?
}

model Address {
  id String @id @default(uuid())

  userId String

  label         String
  recipientName String
  phone         String

  addressLine1 String
  addressLine2 String?
  area         String?
  city         String
  province     String?
  postalCode   String?
  country      String

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpSession {
  id         String    @id @default(uuid())
  phone      String
  otp        String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  genericName String? // Salt Composition (e.g. Domperidone 30mg + Pantoprazole 40mg)
  brandName   String? // Marketer / Brand (e.g. Leeford Healthcare Ltd)

  // Pricing & Discounts
  price         Float?
  originalPrice Float?

  // 1mg Detailed Medical Content Columns
  description  String? @db.Text // Overview / Summary
  uses         String? @db.Text // Indications & Uses list
  benefits     String? @db.Text // Detailed benefits of medicine
  sideEffects  String? @db.Text // Common side effects
  howToUse     String? @db.Text // Directions for use & dosage
  working      String? @db.Text // How medicine works / Mechanism
  safetyAdvice String? @db.Text // Alcohol, Pregnancy, Driving, Liver/Kidney warnings
  quickTips    String? @db.Text // Doctor advice / Patient quick tips
  storage      String? // Storage conditions (e.g. Store below 30°C)

  category    String?
  subCategory String?

  // ==========================================
  // NEW 1MG COLLECTION & FILTERING FIELDS
  // ==========================================
  systemOfMedicine String?  @default("Allopathy") // e.g., Allopathy, Homeopathy, Herbal, Ayurveda, Unani
  healthConditions String[] // e.g., ["diabetes", "cough-and-flu", "skin-care", "hair-care"]
  ingredients      String[] // e.g., ["collagen", "vitamin-c", "salicylic-acid", "paracetamol"]
  tags             String[] // e.g., ["supplement-of-the-week", "bestseller", "trending", "deal-of-the-day"]
  isFeatured       Boolean  @default(false) // For collection hero sections & landing pages

  dosageForm String? // Capsule, Tablet, Syrup
  strength   String? // e.g. 30mg/40mg
  packSize   String? // e.g. 10 capsules in 1 strip

  manufacturer String?

  prescriptionRequired Boolean @default(false)

  imageUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacyProducts PharmacyProduct[]
  matchedPharmacyOffers PharmacyProduct[] @relation("PharmacyProductMatchedProduct")
  cartItems        CartItem[]
  orderItems       OrderItem[]
}

model Pharmacy {
  id String @id @default(cuid())

  // Phase 1: Pharmacy & Owner
  name             String
  ownerName        String?
  pharmacyType     String? @default("Retail") // Retail, Hospital, Chain, Online
  pharmacistName   String?
  pharmacistRegNum String?
  logoUrl          String?
  whatsappNumber   String?
  phone            String?
  email            String?

  // Phase 2: Documents
  drugLicenseNumber   String?
  drugLicensePhotoUrl String?
  cnicNtnNumber       String?
  cnicFrontPhotoUrl   String?
  cnicBackPhotoUrl    String?

  // Phase 3: Location & Hours
  address    String?
  city       String?
  province   String?
  postalCode String?
  country    String  @default("Pakistan")
  latitude   Float?
  longitude  Float?
  isOpen247  Boolean @default(false)

  // Phase 4: Payout & Agreement
  userId          String?  // Link to the pharmacy's user account (if applicable)
  paymentMethod    String? @default("JazzCash") // JazzCash, Easypaisa, Bank
  accountTitle     String?
  accountNumber    String?
  coldChainStorage Boolean @default(false)
  referralCode     String?
  agreedToTerms    Boolean @default(false) // Application & Verification Status

  // Application & Verification Status
  status   String  @default("PENDING") // PENDING, APPROVED, REJECTED
  isActive Boolean @default(false) // Active after admin verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      PharmacyProduct[]
  notifications Notification[]
  pharmacyOrderRequests PharmacyOrderRequest[]
  fulfilledOrderItems OrderItem[]
}

model PharmacyRegistration {
  id           String   @id @default(uuid())
  phone        String   @unique
  email        String?  @unique
  isFormFilled Boolean  @default(false)
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phone])
}

model PharmacyProduct {
  id String @id @default(cuid())

  // Global catalog link. Stays NULL while the offer is only an uploaded draft -
  // nothing reaches the Product table until an admin pushes it.
  productId  String?
  pharmacyId String

  // Uploaded catalog details (CSV row / seller form)
  draftName        String?
  draftSlug        String?
  draftGenericName String?
  draftBrandName   String?
  draftCategory    String?
  draftSubCategory String?
  draftDescription String?
  draftImageUrl    String?

  // Admin review workflow
  approvalStatus String @default("PENDING") // PENDING | APPROVED | REJECTED
  matchedProductId String? // Global product this offer was recognized as similar to
  syncedAt       DateTime?

  sku      String? // Internal Barcode/SKU code
  price    Decimal  @db.Decimal(10, 2)
  mrp      Decimal? @db.Decimal(10, 2)
  discount Float?   @default(0)
  stock    Int      @default(0)

  isAvailable Boolean @default(true)

  metadata Json? // 👈 Pharmacy specific extra info (e.g. Rack location, Expiry date, Supplier)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  matchedProduct Product?  @relation("PharmacyProductMatchedProduct", fields: [matchedProductId], references: [id], onDelete: SetNull)
  pharmacy       Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([pharmacyId])
  @@index([productId, pharmacyId])
  @@index([pharmacyId, approvalStatus])
  @@index([matchedProductId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id              String   @id @default(uuid())
  userId          String
  status          String   @default("PENDING")
  totalAmount     Float
  shippingAddress String?
  paymentMethod   String   @default("COD")
  paymentStatus   String   @default("PENDING")
  lat             Float?
  lng             Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  items             OrderItem[]
  notifications     Notification[]
  prescriptions     Prescription[]
  userNotifications UserNotification[]
  pharmacyOrderRequests PharmacyOrderRequest[]
}

// 👇 NEW ENUM for tracking individual item status
enum OrderItemStatus {
  PENDING
  ASSIGNED
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  productId          String
  productName        String
  quantity           Int
  price              Float
  total              Float

  // 👇 NEW FIELDS
  status             OrderItemStatus @default(PENDING)
  assignedPharmacyId String?
  assignedPharmacy   Pharmacy?       @relation(fields: [assignedPharmacyId], references: [id], onDelete: SetNull)

  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  isAvailable        Boolean         @default(true)
}

model Notification {
  id         String   @id @default(uuid())
  type       String
  title      String
  message    String
  orderId    String?
  pharmacyId String? // <--- New Optional Field
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade) // <--- Relation
}

model Prescription {
  id        String   @id @default(uuid())
  userId    String
  orderId   String?
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title     String
  message   String
  type      String // e.g. 'ORDER_STATUS_UPDATE', 'PRODUCT_UNAVAILABLE'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}


// ------------------------------------------------------
// ENUMS FOR CONSULTATION MODULE
// ------------------------------------------------------

enum PatientType {
  SELF
  FAMILY_MEMBER
}

enum RelationType {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum ConsultationFlowType {
  INSTANT_3_MIN     // 3-Minute Instant Matching
  DOCTOR_LISTING    // Nearby/Descending Doctor List Selection
}

enum ConsultationServiceMode {
  IN_CLINIC
  TEXT
  VIDEO
}

enum IntakeStatus {
  DRAFT
  PENDING_MATCHING
  DOCTOR_ASSIGNED
  COMPLETED
  CANCELLED
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

// Family Members under Primary Logged-in User
model FamilyMember {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName     String
  relation     RelationType
  gender       String             // e.g. "Male", "Female", "Other"
  age          Int?
  dateOfBirth  DateTime?
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  consultations ConsultationIntake[]

  @@map("family_members")
}

// Speciality Categories (Searchable & Filterable)
model Speciality {
  id           String             @id @default(uuid())
  name         String             @unique // e.g., "Dermatologist", "General Physician"
  slug         String             @unique
  iconUrl      String?
  description  String?
  category     String?            // e.g., "General", "Specialist", "Surgery"
  isActive     Boolean            @default(true)

  consultations ConsultationIntake[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("specialities")
}

// Main Consultation Intake Record
model ConsultationIntake {
  id                  String                  @id @default(uuid())
  
  // Logged-in User
  userId              String
  user                User                    @relation(fields: [userId], references: [id])

  // Patient Info (Self or Family Member)
  patientType         PatientType             @default(SELF)
  familyMemberId      String?
  familyMember        FamilyMember?           @relation(fields: [familyMemberId], references: [id])
  
  // Snapshot of Address at time of intake (used for distance calculation)
  patientAddress      Json?                   // Stores { street, city, latitude, longitude, area }

  // Selected Speciality
  specialityId        String
  speciality          Speciality              @relation(fields: [specialityId], references: [id])

  // Health Problem Details
  symptoms            String[]                // e.g. ["Fever", "Headache"]
  symptomDuration     String?                 // e.g. "2 Days", "1 Week"
  description         String?                 @db.Text
  attachments         String[]                // URLs of uploaded reports/photos

  // Next Step Configurations
  flowType            ConsultationFlowType?   // INSTANT_3_MIN or DOCTOR_LISTING
  serviceMode         ConsultationServiceMode? // IN_CLINIC, TEXT, VIDEO

  // Lifecycle Status
  status              IntakeStatus            @default(DRAFT)

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@map("consultation_intakes")
}

// ------------------------------------------------------
// ENUM FOR DOCTOR REGISTRATION STATUS
// ------------------------------------------------------

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------------------
// DOCTOR REGISTRATION & PROFILE MODELS
// ------------------------------------------------------

model Doctor {
  id                    String               @id @default(uuid())
  
  // Optional link to existing User account
  userId                String?              @unique
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 1. Personal Information
  fullName              String
  title                 String               // e.g. "Consultant Family Physician"
  degrees               String               // e.g. "MBBS, FCPS (Family Medicine)"
  pmdcNumber            String               @unique
  pmdcCertificateUrl    String?              // Image URL for PMDC degree/certificate
  experienceYears       Int
  languages             String[]             // e.g. ["English", "Urdu", "Punjabi"]
  phone                 String
  email                 String?
  specialisations       String[]             // e.g. ["Family medicine", "Women's health"]
  education             String?              // e.g. "Aga Khan University"
  about                 String?              @db.Text
  profilePhotoUrl       String?

  // 2. Consultation Types (Duration / Time removed as requested)
  isVideoCallEnabled    Boolean              @default(false)
  videoCallFee          Float?

  isTextConsultEnabled  Boolean              @default(false)
  textConsultFee        Float?

  // System Status
  status                DoctorStatus         @default(PENDING)
  isActive              Boolean              @default(true)

  // Relations
  clinics               DoctorClinic[]
  onlineAvailabilities  DoctorAvailability[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("doctors")
}

// Clinics where Doctor practices (OpenStreetMap Address + Lat/Lng)
model DoctorClinic {
  id           String                  @id @default(uuid())
  doctorId     String
  doctor       Doctor                  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  name         String
  phone        String?
  inPersonFee  Float

  // Location fields for OpenStreetMap integration
  address      String
  latitude     Float?
  longitude    Float?

  // Timing schedules for this clinic
  schedules    DoctorClinicSchedule[]

  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@map("doctor_clinics")
}

// Days and timing slots for Clinics
model DoctorClinicSchedule {
  id           String       @id @default(uuid())
  clinicId     String
  clinic       DoctorClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  dayOfWeek    String       // e.g. "Monday", "Tuesday"
  startTime    String       // e.g. "10:00 AM"
  endTime      String       // e.g. "01:00 PM"

  @@map("doctor_clinic_schedules")
}

// Weekly availability for Online Consultations (Video/Text)
model DoctorAvailability {
  id           String   @id @default(uuid())
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek    String   // e.g. "Monday", "Tuesday"
  startTime    String   // e.g. "10:00 AM"
  endTime      String   // e.g. "01:00 PM"

  @@map("doctor_availabilities")
}